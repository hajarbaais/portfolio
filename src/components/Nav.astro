---
const links = [
  { label: 'Profil', href: '#about' },
  { label: 'Parcours', href: '#formation' },
  { label: 'Expérience', href: '#experience' },
  { label: 'Compétences', href: '#skills' },
  { label: 'Projets', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---
<header class="fixed top-4 inset-x-0 z-50 px-4 pointer-events-none">
  <nav
    id="nav"
    class="pointer-events-auto mx-auto max-w-fit flex items-center gap-2 rounded-full border border-white/10 bg-bg/70 backdrop-blur-xl pl-5 pr-2 py-2 transition-all duration-500"
  >
    <a href="#top" class="font-display font-bold text-white mr-3 tracking-tight" aria-label="Retour en haut">
      HB<span class="text-accent">.</span>
    </a>
    <ul class="hidden lg:flex items-center gap-1 text-sm">
      {links.map((l) => (
        <li>
          <a href={l.href} data-nav class="block px-3.5 py-1.5 rounded-full text-ink-muted hover:text-white transition-colors">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="hidden sm:inline-flex lg:hidden items-center px-4 py-1.5 rounded-full bg-accent text-bg text-sm font-medium">
      Contact
    </a>
    <button
      id="nav-toggle"
      class="lg:hidden w-9 h-9 grid place-items-center rounded-full text-ink hover:bg-white/5"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="relative block w-4 h-3">
        <span class="bar absolute left-0 top-0 w-4 h-px bg-current transition-transform duration-300"></span>
        <span class="bar absolute left-0 bottom-0 w-4 h-px bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </nav>

  <div
    id="nav-menu"
    class="pointer-events-auto lg:hidden mx-auto mt-3 max-w-sm rounded-3xl border border-white/10 bg-bg/90 backdrop-blur-xl p-3 origin-top transition-all duration-300 opacity-0 scale-95 invisible"
  >
    <ul>
      {links.map((l, i) => (
        <li>
          <a href={l.href} class="flex items-baseline gap-4 px-4 py-3 rounded-2xl hover:bg-white/5 group">
            <span class="font-mono text-xs text-ink-faint">0{i + 1}</span>
            <span class="font-display text-xl font-semibold text-white group-hover:text-accent transition-colors">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  [data-nav].active {
    background: rgba(0, 255, 156, 0.12);
    color: #00ff9c;
  }
  #nav-toggle[aria-expanded='true'] .bar:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #nav-toggle[aria-expanded='true'] .bar:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  #nav-menu.open {
    opacity: 1;
    transform: scale(1);
    visibility: visible;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Met en évidence la section visible dans la barre de navigation
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const sections = document.querySelectorAll('main section[id]');
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${entry.target.id}`));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((s) => spy.observe(s));
</script>
