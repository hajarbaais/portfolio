---
const gh = (repo: string) => `https://github.com/hajarbaais/${repo}`;

const featured = [
  {
    title: "GED — Service d'archivage probant",
    tagline: 'Sécurité de bout en bout pour une Gestion Électronique de Documents',
    repo: gh('ged-security-project'),
    stack: ['FastAPI', 'PostgreSQL', 'HashiCorp Vault', 'Sigstore Rekor', 'ClamAV', 'Wazuh', 'Docker', 'GitHub Actions'],
    points: [
      "Chiffrement par enveloppe AES-256-GCM : une clé par document, protégée par une clé maîtresse gérée dans Vault.",
      'Preuve d’intégrité inviolable : empreintes SHA-256 scellées dans un registre de transparence (arbre de Merkle, RFC 6962).',
      'JWT, RBAC par rôle et par ressource, rate limiting, antivirus, DLP (IBAN/cartes), protection anti zip-bomb et zip-slip.',
      'Supervision SIEM : 9 types d’événements de sécurité et règles Wazuh dédiées ; scans Trivy et OWASP ZAP en CI/CD.',
    ],
    metrics: ['350+ tests unitaires', 'Réalisé en stage chez Netalek'],
  },
  {
    title: 'API Sentinel',
    tagline: 'Framework de test de sécurité pour API REST et GraphQL',
    repo: gh('API-Sentinel'),
    stack: ['Python 3.11', 'OpenAPI', 'GraphQL', 'SARIF'],
    points: [
      'Détection BOLA/IDOR par tests différentiels multi-comptes : exploitabilité prouvée par rejeu, pas de simple heuristique.',
      'Couvre aussi BFLA, mass assignment, exposition excessive de données, absence de rate limiting, abus GraphQL et SSRF vers les métadonnées cloud.',
      'Chaque finding inclut une preuve rejouable et un score de confiance ; allowlist de cibles obligatoire avant tout scan.',
    ],
    metrics: ['OWASP API Top 10', 'Rapports HTML · JSON · SARIF'],
  },
];

const projects = [
  {
    title: 'Phishing Email Analyzer',
    repo: gh('phishing-email-detection'),
    stack: ['Python', 'Flask', 'Pytest'],
    points: [
      'Analyse des en-têtes SPF/DKIM/DMARC et détection de spoofing.',
      'Scan des URLs et des pièces jointes (archives inspectées en mémoire), score de risque configurable en YAML.',
    ],
  },
  {
    title: 'Serveur HTTP en assembleur x86-64',
    repo: gh('webserver-asm'),
    stack: ['NASM', 'Linux syscalls', 'Docker'],
    points: [
      'Serveur HTTP/1.1 écrit entièrement en assembleur, sans bibliothèque, uniquement avec des appels système Linux.',
      'Sert des fichiers statiques et gère les erreurs 404, avec un binaire de moins de 15 Ko.',
    ],
  },
  {
    title: 'Microservices gRPC sécurisés par TLS',
    repo: gh('grpc_chat_log_project'),
    stack: ['Python', 'gRPC', 'Protobuf', 'TLS'],
    points: [
      'LogService : ingestion et analyse de logs en unary et en streaming.',
      'ChatService : messagerie bidirectionnelle temps réel ; canaux chiffrés avec une autorité de certification dédiée.',
    ],
  },
  {
    title: 'LLM Guardrails contre Prompt Injection et Jailbreak',
    status: 'En cours',
    stack: ['Python', 'FastAPI', 'DeBERTa-v3', 'Llama Guard 3', 'LangChain', 'garak / PyRIT'],
    points: [
      'Proxy de sécurité multicouche placé devant une application LLM (RAG + agent avec outils) : filtre d’entrée, prompt durci, filtre de sortie et scan des documents RAG.',
      'Couvre les injections directes et indirectes, les jailbreaks, l’obfuscation et les attaques multilingues (français, arabe, darija).',
      'Objectif : diviser par 5 le taux de succès des attaques avec moins de 5 % de faux positifs ; décisions journalisées et mappées sur MITRE ATLAS (OWASP LLM01).',
    ],
  },
  {
    title: 'Dark Data Analyzer',
    repo: gh('Dark_Data'),
    stack: ['Python', 'Linux'],
    points: [
      'Parcours du système de fichiers en lecture seule pour repérer les données anciennes, inutilisées ou à risque.',
      'Détection des permissions trop ouvertes et des extensions sensibles, rapports JSON, CSV et HTML.',
    ],
  },
  {
    title: 'Détection de menaces : architecture Lambda',
    stack: ['Python', 'Spark', 'Hadoop', 'Machine Learning'],
    points: [
      'Couche batch : ingestion, traitement massif et classification de logs historiques.',
      'Entraînement et évaluation de modèles supervisés sur des datasets de menaces.',
    ],
  },
];
---
<section id="projects" class="section reveal">
  <p class="section-title">05 — Projets</p>
  <h2 class="section-heading">Projets phares</h2>

  <div class="space-y-6 mb-6">
    {featured.map((p) => (
      <article class="card border-accent/30">
        <div class="flex flex-wrap justify-between items-start gap-3 mb-2">
          <div>
            <p class="font-mono text-xs text-accent mb-1">Projet vedette</p>
            <h3 class="text-xl font-semibold text-white">{p.title}</h3>
          </div>
          <a href={p.repo} target="_blank" rel="noopener" class="font-mono text-xs link border border-line rounded px-3 py-1.5 hover:border-accent">
            Code source ↗
          </a>
        </div>
        <p class="text-ink-muted mb-4">{p.tagline}</p>
        <ul class="space-y-2 text-ink-muted text-sm leading-relaxed mb-5">
          {p.points.map((pt) => (
            <li class="flex gap-3">
              <span class="text-accent mt-1.5">▹</span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-2 mb-3">
          {p.metrics.map((m) => (
            <span class="font-mono text-xs px-2 py-1 rounded bg-accent/10 text-accent-soft">{m}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-2">
          {p.stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </article>
    ))}
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    {projects.map((p) => (
      <article class="card flex flex-col">
        <div class="flex justify-between items-start gap-3 mb-3">
          <h3 class="text-lg font-medium text-white">{p.title}</h3>
          {p.status && (
            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-amber-300 border border-amber-300/40 bg-amber-300/10 rounded-full px-2.5 py-0.5 shrink-0 mt-1">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-300 animate-pulse"></span>
              {p.status}
            </span>
          )}
          {p.repo && (
            <a href={p.repo} target="_blank" rel="noopener" class="link font-mono text-xs shrink-0 mt-1" aria-label={`Code source de ${p.title}`}>
              GitHub ↗
            </a>
          )}
        </div>
        <ul class="space-y-2 text-ink-muted text-sm leading-relaxed mb-4 flex-1">
          {p.points.map((pt) => (
            <li class="flex gap-3">
              <span class="text-accent mt-1.5">▹</span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-2">
          {p.stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </article>
    ))}
  </div>

  <p class="mt-10 text-center">
    <a href="https://github.com/hajarbaais?tab=repositories" target="_blank" rel="noopener" class="font-mono text-sm link">
      Voir tous les dépôts sur GitHub ↗
    </a>
  </p>
</section>
