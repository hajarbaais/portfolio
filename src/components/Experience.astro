---
const experiences = [
  {
    role: 'Stagiaire en Sécurité Applicative',
    company: 'Netalek Services',
    period: 'Juillet 2026',
    points: [
      "Mise en place d'un système de sécurité pour une solution de gestion électronique des documents (GED), dans un contexte de transformation digitale.",
      "Développement d'une API de sécurité avec FastAPI : chiffrement AES-256-GCM, contrôle d'intégrité des documents, analyse antivirus, authentification JWT.",
      'Supervision et détection des menaces avec Wazuh SIEM ; intégration de contrôles de sécurité automatisés dans le pipeline CI/CD.',
    ],
  },
  {
    role: 'Stagiaire en Cybersécurité & Pentest Web',
    company: 'YOOL Education, Agadir',
    period: 'Juillet 2025',
    points: [
      "Audit de sécurité multidimensionnel : évaluation de la résilience du site yool.education via reconnaissance (footprinting) et tests d'intrusion manuels/automatisés.",
      "Analyse de vulnérabilités (OWASP Top 10) : identification et exploitation de failles critiques.",
      'Remédiation & Hardening : rédaction de rapports techniques détaillés et mise en œuvre de recommandations de durcissement serveur et correctifs de sécurité applicative.',
    ],
  },
];
---
<section id="experience" class="section">
  <div class="sec-head">
    <span class="sec-num">03</span>
    <h2 class="sec-title">Expérience</h2>
    <span class="sec-line"></span>
  </div>

  <div id="timeline" class="relative">
    <div class="absolute left-[7px] md:left-[calc(220px+7px)] top-2 bottom-2 w-px bg-line" aria-hidden="true">
      <div id="timeline-fill" class="absolute inset-x-0 top-0 h-full bg-gradient-to-b from-accent to-violet origin-top" style="transform: scaleY(0)"></div>
    </div>

    <div class="space-y-16 md:space-y-24">
      {experiences.map((exp) => (
        <article class="reveal relative grid md:grid-cols-[220px_1fr] gap-4 md:gap-0 pl-10 md:pl-0">
          <div class="md:pr-10 md:text-right md:pt-1">
            <p class="font-mono text-sm text-accent">{exp.period}</p>
            <p class="text-ink-faint text-sm mt-1">{exp.company}</p>
          </div>
          <span class="absolute left-0 md:left-[220px] top-1.5 w-[15px] h-[15px] rounded-full border-2 border-accent bg-bg" aria-hidden="true"></span>
          <div class="md:pl-14">
            <h3 class="font-display text-2xl md:text-3xl font-semibold text-white leading-tight mb-6">{exp.role}</h3>
            <ul class="space-y-4">
              {exp.points.map((p) => (
                <li class="flex gap-4 text-ink-muted leading-relaxed">
                  <span class="mt-2.5 w-4 h-px bg-accent shrink-0" aria-hidden="true"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // La ligne de la frise se remplit au fil du défilement
  const timeline = document.getElementById('timeline');
  const fill = document.getElementById('timeline-fill');
  const update = () => {
    if (!timeline || !fill) return;
    const r = timeline.getBoundingClientRect();
    const progress = (window.innerHeight * 0.6 - r.top) / r.height;
    fill.style.transform = `scaleY(${Math.min(1, Math.max(0, progress))})`;
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
