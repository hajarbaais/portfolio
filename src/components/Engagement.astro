---
const engagements = [
  'Meilleure participation féminine — Morocco Academia Cyber Competition (MACC 2026)',
  'Participation active à des compétitions CTF (Capture The Flag)',
  'Responsable Communication — ADE ENSA Agadir',
  'Secrétaire — APPS Club ENSA Agadir',
  'Vice-coordinatrice — Événement « Info Days » ENSA Agadir',
];

const languages = [
  { name: 'Arabe', level: 'Langue maternelle' },
  { name: 'Français', level: 'Courant' },
  { name: 'Anglais', level: 'Courant' },
];

const [highlight, ...others] = engagements;
---
<section id="engagement" class="section">
  <div class="sec-head">
    <span class="sec-num">07</span>
    <h2 class="sec-title">Engagement & CTF</h2>
    <span class="sec-line"></span>
  </div>

  <div class="grid lg:grid-cols-[1.4fr_1fr] gap-6">
    <div class="reveal spot p-8 md:p-12 flex flex-col justify-between min-h-[240px] bg-gradient-to-br from-bg-card to-bg">
      <svg class="relative w-14 h-14 text-accent" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M16 6h16v10a8 8 0 0 1-16 0V6Z" />
        <path d="M16 10H9v3a7 7 0 0 0 7 7M32 10h7v3a7 7 0 0 1-7 7M24 24v8M17 42h14M19 42l1.5-10h7L29 42" />
      </svg>
      <p class="relative font-display text-xl md:text-2xl font-bold text-white leading-snug tracking-tight mt-10">
        {highlight}
      </p>
    </div>

    <div class="reveal spot p-8 md:p-10" style="--i: 1">
      <h3 class="kicker mb-6 relative">Langues</h3>
      <ul class="relative space-y-6">
        {languages.map((l) => (
          <li>
            <p class="font-display text-xl font-semibold text-white">{l.name}</p>
            <p class="font-mono text-xs text-accent mt-1">{l.level}</p>
          </li>
        ))}
      </ul>
    </div>

    <ul class="lg:col-span-2 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {others.map((e, i) => (
        <li class="reveal spot p-6 flex flex-col gap-6 min-h-[170px]" style={`--i: ${i}`}>
          <span class="relative font-mono text-xs text-ink-faint">0{i + 2}</span>
          <p class="relative text-ink leading-snug mt-auto">{e}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
