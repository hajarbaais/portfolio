---
const items = [
  {
    title: 'Cycle Ingénieur en Cybersécurité',
    place: 'ENSA Agadir',
    period: '2024 — Présent',
  },
  {
    title: 'Classes Préparatoires Intégrées',
    place: 'ENSA Agadir',
    period: '2022 — 2024',
  },
  {
    title: 'Baccalauréat Sciences Physiques',
    place: 'Lycée Argan',
    period: '2022',
  },
];
---
<section id="formation" class="section reveal">
  <p class="section-title">02 — Formation</p>
  <h2 class="section-heading">Parcours académique</h2>
  <div class="relative border-l border-line pl-8 space-y-10">
    {items.map((item) => (
      <div class="relative">
        <span class="absolute -left-[37px] top-1.5 w-3 h-3 rounded-full bg-accent"></span>
        <p class="font-mono text-xs text-accent mb-1">{item.period}</p>
        <h3 class="text-lg font-medium text-white">{item.title}</h3>
        <p class="text-ink-muted text-sm">{item.place}</p>
      </div>
    ))}
  </div>
</section>