---
const skills = [
  { category: 'Sécurité offensive', items: ["Tests d'intrusion web", 'OWASP Top 10', 'OWASP API Top 10', 'Reconnaissance / footprinting', 'CTF'] },
  { category: 'Sécurité défensive', items: ['SIEM / SOC', 'Wazuh', 'Hardening Linux', 'IAM / PAM', 'DAC / MAC', 'Tripwire'] },
  { category: 'Sécurité applicative', items: ['JWT', 'RBAC', 'Rate limiting', 'Validation des uploads', 'DLP', 'Antivirus (ClamAV)', 'MITRE ATT&CK'] },
  { category: 'Outils', items: ['Burp Suite', 'OWASP ZAP', 'Nmap', 'Wireshark', 'Trivy', 'HashiCorp Vault'] },
  { category: 'Cryptographie', items: ['AES-GCM', 'DES', 'RSA', 'ECC', 'PKI / certificats', 'Hachage', 'Arbres de Merkle'] },
  { category: 'Réseaux', items: ['TLS', 'Tunnels IPsec', 'DNS', 'LDAP', 'NFS', 'Firewalls', 'Proxy Squid'] },
  { category: 'Langages', items: ['Python', 'C', 'Assembleur x86-64 (NASM)', 'Java', 'PHP', 'JavaScript'] },
  { category: 'Frameworks & données', items: ['FastAPI', 'Flask', 'gRPC / Protobuf', 'PostgreSQL', 'MySQL', 'Angular', 'Laravel'] },
  { category: 'DevSecOps & data', items: ['Docker / Compose', 'GitHub Actions', 'Git', 'Pytest', 'Spark / Hadoop'] },
];
---
<section id="skills" class="section">
  <div class="sec-head">
    <span class="sec-num">04</span>
    <h2 class="sec-title">Compétences</h2>
    <span class="sec-line"></span>
  </div>

  <div class="reveal grid md:grid-cols-[320px_1fr] gap-10 md:gap-16">
    <div class="hidden md:flex flex-col" role="tablist" aria-label="Catégories de compétences" aria-orientation="vertical">
      {skills.map((s, i) => (
        <button
          role="tab"
          id={`skill-tab-${i}`}
          aria-controls={`skill-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="skill-tab group flex items-center gap-4 text-left py-3.5 border-b border-line"
        >
          <span class="font-mono text-xs text-ink-faint w-6">0{i + 1}</span>
          <span class="flex-1 font-display text-base font-medium text-ink-muted group-hover:text-white transition-colors">{s.category}</span>
          <span class="tab-dot w-1.5 h-1.5 rounded-full bg-accent scale-0 transition-transform duration-300"></span>
        </button>
      ))}
    </div>

    <div class="relative md:min-h-[420px]">
      {skills.map((s, i) => (
        <div
          role="tabpanel"
          id={`skill-panel-${i}`}
          aria-labelledby={`skill-tab-${i}`}
          class={`skill-panel mb-10 md:mb-0 ${i === 0 ? 'active' : ''}`}
        >
          <p class="font-mono text-xs text-ink-faint mb-2 md:hidden">0{i + 1}</p>
          <h3 class="font-display text-2xl md:text-4xl font-bold text-white tracking-tight mb-8 md:mb-12">{s.category}</h3>
          <ul class="flex flex-wrap gap-3">
            {s.items.map((item, k) => (
              <li class="chip" style={`--k: ${k}`}>
                <span class="inline-block font-mono text-sm px-4 py-2 rounded-full border border-line bg-bg-card text-ink hover:border-accent hover:text-accent transition-colors">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-tab[aria-selected='true'] .font-display {
    color: #fff;
  }
  .skill-tab[aria-selected='true'] .tab-dot {
    transform: scale(1);
  }
  .skill-tab[aria-selected='true'] .font-mono {
    color: #00ff9c;
  }
  @media (min-width: 768px) {
    .skill-panel:not(.active) {
      display: none;
    }
    .skill-panel.active .chip {
      animation: chip-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--k) * 45ms);
    }
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.skill-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.skill-panel')];

  const select = (index: number, focus = false) => {
    tabs.forEach((t, i) => {
      const on = i === index;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p, i) => p.classList.toggle('active', i === index));
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('mouseenter', () => select(i));
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowUp') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
    });
  });
</script>
