---
const skills = [
  { category: 'Sécurité offensive', items: ["Tests d'intrusion web", 'OWASP Top 10', 'OWASP API Top 10', 'Reconnaissance / footprinting', 'CTF'] },
  { category: 'Sécurité défensive', items: ['SIEM / SOC', 'Wazuh', 'Hardening Linux', 'IAM / PAM', 'DAC / MAC', 'Tripwire'] },
  { category: 'Sécurité applicative', items: ['JWT', 'RBAC', 'Rate limiting', 'Validation des uploads', 'DLP', 'Antivirus (ClamAV)'] },
  { category: 'Outils', items: ['Burp Suite', 'OWASP ZAP', 'Nmap', 'Wireshark', 'Trivy', 'HashiCorp Vault'] },
  { category: 'Cryptographie', items: ['AES-GCM', 'DES', 'RSA', 'ECC', 'PKI / certificats', 'Hachage', 'Arbres de Merkle'] },
  { category: 'Réseaux', items: ['TLS', 'Tunnels IPsec', 'DNS', 'LDAP', 'NFS', 'Firewalls', 'Proxy Squid'] },
  { category: 'Langages', items: ['Python', 'C', 'Assembleur x86-64 (NASM)', 'Java', 'PHP', 'JavaScript', 'Kotlin'] },
  { category: 'Frameworks & données', items: ['FastAPI', 'Flask', 'gRPC / Protobuf', 'PostgreSQL', 'MySQL', 'Angular', 'Laravel'] },
  { category: 'DevSecOps & data', items: ['Docker / Compose', 'GitHub Actions', 'Git', 'Pytest', 'Spark / Hadoop', 'scikit-learn'] },
];
---
<section id="skills" class="section reveal">
  <p class="section-title">04 — Expertise technique</p>
  <h2 class="section-heading">Compétences</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {skills.map((s) => (
      <div class="card">
        <h3 class="font-mono text-sm text-accent mb-3">{s.category}</h3>
        <div class="flex flex-wrap gap-2">
          {s.items.map((i) => <span class="tag">{i}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>
